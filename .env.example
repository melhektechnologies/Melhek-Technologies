# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/melhek_pharmacy"
# Auth
JWT_SECRET="replace_with_strong_secret"
SESSION_TTL_MINUTES=120

# Internal workspaces (server-only; never use NEXT_PUBLIC_ variables)
PRICING_ACCESS_KEY="set_a_unique_key_of_at_least_16_characters"
PRICING_SESSION_SECRET="set_a_random_secret_of_at_least_32_characters"

# Redis / caching
REDIS_URL="redis://localhost:6379"

# Queue / async jobs
QUEUE_DRIVER=redis

# Notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user
SMTP_PASS=pass
SMS_PROVIDER_API_KEY=replace_me

# Monitoring
SENTRY_DSN=
LOG_LEVEL=info

CONTACT_WEBHOOK_URL="https://discord.com/api/webhooks/your-webhook-id-here"
