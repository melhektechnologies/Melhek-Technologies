# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/melhek_pharmacy"

# Auth
JWT_SECRET="replace_with_strong_secret"
SESSION_TTL_MINUTES=120

# Redis / caching
REDIS_URL="redis://localhost:6379"

# Queue / async jobs
QUEUE_DRIVER=redis

# Notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user
SMTP_PASS=pass
SMS_PROVIDER_API_KEY=replace_me

# Monitoring
SENTRY_DSN=
LOG_LEVEL=info
